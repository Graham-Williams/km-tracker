# Copy to .env and fill in. .env is gitignored — never commit real values.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cloudflare named-tunnel token. Copy it from the Cloudflare Zero Trust
# dashboard when you create the tunnel (Networks → Tunnels → Create a tunnel).
TUNNEL_TOKEN=

# --- App-level shared-password login gate (see DEPLOY.md → "Sign-in") ---

# The shared password Graham hands to friends. When SET, the app shows a
# /login page and requires this password (one entry -> 30-day signed-cookie
# session). When BLANK/UNSET the gate is OFF and the app behaves as before —
# so you can deploy it dormant behind Cloudflare Access, then activate it at
# cutover just by filling this in. Constant-time compared; never logged.
APP_PASSWORD=

# Optional. Signing key for the login session cookie. LEAVE BLANK — the gate
# reuses SECRET_KEY above to sign the session, so a separate secret isn't
# needed. Set this only if you deliberately want a dedicated key (SECRET_KEY
# still wins if both are set). Generate like SECRET_KEY if you do use it.
SESSION_SECRET=

# --- Public access hardening (see DEPLOY.md → "Public access hardening") ---

# Optional. The host the app should treat as "itself" for the CSRF Origin/Referer
# check (e.g. km.example.com). Leave blank to use the incoming request's Host
# header, which is correct when Cloudflare forwards the original hostname.
APP_HOST=

# Cloudflare Access team domain, e.g. yourteam.cloudflareaccess.com
# (Zero Trust → Settings → Custom Pages / team domain). Leave BOTH this and
# CF_ACCESS_AUD blank in local dev / on the tailnet to skip Access verification.
CF_ACCESS_TEAM_DOMAIN=

# Cloudflare Access application AUD tag (Zero Trust → Access → your app →
# Overview → Application Audience (AUD) Tag). Setting this AND
# CF_ACCESS_TEAM_DOMAIN turns on app-side Access JWT verification.
CF_ACCESS_AUD=

# --- Staging environment (see DEPLOY.md → "Staging environment") ---

# AUD tag of the SEPARATE staging Cloudflare Access application
# (staging-km.graham-williams.com). Staging gets its OWN Access app, so its OWN
# AUD — do NOT reuse the prod CF_ACCESS_AUD above. Copy it from Zero Trust →
# Access → (staging app) → Overview → Application Audience (AUD) Tag. Only used
# by the staging-app container (docker-compose.staging.yml).
STAGING_CF_ACCESS_AUD=

# Optional. Shared-password gate for STAGING only. Lets you exercise the /login
# gate on staging without turning it on for prod. Falls back to APP_PASSWORD if
# blank; blank on both leaves staging's gate OFF.
STAGING_APP_PASSWORD=

# --- Photo score entry (optional) ---

# Anthropic API key for photo score extraction (reads a photographed standings
# screen via the Claude API). OPTIONAL: leave blank and the feature disables
# itself gracefully — the score forms fall back to attach-only photo mode and
# manual entry is unaffected.
ANTHROPIC_API_KEY=
