# Copy to .env and fill in. .env is gitignored — never commit real values.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cloudflare named-tunnel token. Copy it from the Cloudflare Zero Trust
# dashboard when you create the tunnel (Networks → Tunnels → Create a tunnel).
TUNNEL_TOKEN=

# --- App-level shared-password login gate (see DEPLOY.md → "Sign-in") ---

# The shared password Graham hands to friends. When SET, the app shows a
# /login page and requires this password (one entry -> 30-day signed-cookie
# session). When BLANK/UNSET the gate is OFF and the app behaves as before —
# so you can deploy it dormant behind Cloudflare Access, then activate it at
# cutover just by filling this in. Constant-time compared; never logged.
APP_PASSWORD=

# Optional. Signing key for the login session cookie. LEAVE BLANK — the gate
# reuses SECRET_KEY above to sign the session, so a separate secret isn't
# needed. Set this only if you deliberately want a dedicated key (SECRET_KEY
# still wins if both are set). Generate like SECRET_KEY if you do use it.
SESSION_SECRET=

# --- Public access hardening (see DEPLOY.md → "Public access hardening") ---

# Optional here, but LOAD-BEARING in production. The host the app treats as
# "itself" (e.g. km.example.com). Two consumers:
#   1. the CSRF Origin/Referer check — blank falls back to the incoming Host
#      header, which Cloudflare forwards correctly, so the check still works;
#   2. the http->https 307 redirect (DEPLOY.md → "HTTPS enforcement at the
#      origin") — this one FAILS OPEN when blank (no redirect at all), because
#      the target must never be built from the request's own Host (open
#      redirect). It is spliced into a Location header, so it must be a BARE
#      HOSTNAME: no scheme (NOT "https://km.example.com" — that is APP_ORIGIN's
#      format, not this one), no port, no path, no "@", no whitespace. An
#      invalid value is treated as blank (fail open) and logged as a warning at
#      startup under APP_ENV=production.
# Blank is the right value for local dev. Prod/staging get it from
# docker-compose.access.yml / docker-compose.staging.yml, so the box .env only
# needs it if you deploy without those overrides.
APP_HOST=

# Cloudflare Access team domain, e.g. yourteam.cloudflareaccess.com
# (Zero Trust → Settings → Custom Pages / team domain). Leave BOTH this and
# CF_ACCESS_AUD blank in local dev / on the tailnet to skip Access verification.
CF_ACCESS_TEAM_DOMAIN=

# Cloudflare Access application AUD tag (Zero Trust → Access → your app →
# Overview → Application Audience (AUD) Tag). Setting this AND
# CF_ACCESS_TEAM_DOMAIN turns on app-side Access JWT verification.
CF_ACCESS_AUD=

# --- Staging environment (see DEPLOY.md → "Staging environment") ---

# RETIRED 2026-08-05 — leave blank. Staging used to have its own Cloudflare
# Access application (email PIN); that app was deleted and staging now signs in
# with the same shared app-password gate as prod. Blank disables app-side JWT
# verification for staging, which is the intended state.
# Only re-populate if you deliberately re-create a staging Access app: put ITS
# OWN AUD here (Zero Trust → Access → (staging app) → Overview → Application
# Audience (AUD) Tag) — do NOT reuse the prod CF_ACCESS_AUD above. Read only by
# the staging-app container (docker-compose.staging.yml).
STAGING_CF_ACCESS_AUD=

# Optional. Give STAGING a DIFFERENT password from prod. Unset (the normal case)
# means staging inherits APP_PASSWORD; blank on both leaves staging's gate OFF.
STAGING_APP_PASSWORD=

# --- Photo score entry (optional) ---

# Anthropic API key for photo score extraction (reads a photographed standings
# screen via the Claude API). OPTIONAL: leave blank and the feature disables
# itself gracefully — the score forms fall back to attach-only photo mode and
# manual entry is unaffected.
ANTHROPIC_API_KEY=
